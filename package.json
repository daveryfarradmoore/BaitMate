{
  "name": "baitmate",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "ios:sim": "open -a Simulator && sleep 4 && npx expo start --ios",
    "web": "npx expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "deno test --config supabase/functions/deno.json --allow-net --allow-env supabase/functions/_tests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@rnmapbox/maps": "^10.3.5",
    "@supabase/supabase-js": "^2.105.0",
    "expo": "~57.0.20",
    "expo-font": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "mapbox-gl": "^2.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "private": true
