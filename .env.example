# BaitMate environment variables.
# Copy this file to `.env` and fill in real values. Variables prefixed with
# `EXPO_PUBLIC_` are inlined into the Expo app bundle at build time.

# --- App (public) ---------------------------------------------------------
# Supabase project URL, e.g. https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Edge Functions (server only, never inlined into the app bundle) ------
# Service role key used by Edge Functions for privileged DB access
SUPABASE_SERVICE_ROLE_KEY=
# Active price provider: mock | amazon | walmart | hybrid (default: mock)
PRICE_PROVIDER=mock
# Optional LLM curator: on | off (default: off)
LLM_CURATOR=off

# --- Amazon PA-API 5.0 (used only when PRICE_PROVIDER includes amazon) ----
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1

# --- Walmart Affiliate API (used only when PRICE_PROVIDER includes walmart)
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
WALMART_KEY_VERSION=1

# --- LLM provider (used only when LLM_CURATOR=on) -------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
